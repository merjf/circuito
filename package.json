{
  "name": "circuito",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "go": "expo start --go",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "go:android": "expo start --go --android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "deps:check": "node scripts/check-deps.js",
    "apk": "bash scripts/build-apk.sh",
    "apk:install": "bash scripts/build-apk.sh --install"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "~0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "~0.4.1",
    "expo": "~57.0.13",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-file-system": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-notifications": "^57.0.13",
    "expo-router": "~57.0.13",
    "expo-sharing": "^57.0.14",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "^5.1.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "~29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "semver": "^7.8.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}
